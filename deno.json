      "mod.ts",
      "src/**",
      "wasm_activation/pkg/**"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/bytes": "jsr:@std/bytes@1.0.6",
    "@std/crypto": "jsr:@std/crypto@1.1.0",
