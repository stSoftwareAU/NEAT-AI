{
  "name": "@stsoftware/neat-ai",
  "exports": "./mod.ts",
  "version": "0.167.7",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.8",
    "@std/bytes": "jsr:@std/bytes@^1.0.4",
    "@std/crypto": "jsr:@std/crypto@1.0.4",
    "@std/csv": "jsr:@std/csv@^1.0.5",
    "@std/fmt": "jsr:@std/fmt@^1.0.3",
    "@std/fs": "jsr:@std/fs@^1.0.16",
    "@std/path": "jsr:@std/path@1.0.9",
    "@std/streams": "jsr:@std/streams@^1.0.9",
    "@std/uuid": "jsr:@std/uuid@1.0.7",
    "@stsoftware/tags": "jsr:@stsoftware/tags@^1.0.5"
  },
  "test": {
    "include": ["test/**/*.ts"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "jsr"],
      "include": [
        "ban-untagged-todo",
        "camelcase",
        "eqeqeq",
        "no-await-in-loop",
        "no-const-assign",
        "no-useless-rename",
        "no-throw-literal",
        "no-sync-fn-in-async-fn",
        "no-sparse-arrays",
        "no-self-compare",
        "no-non-null-asserted-optional-chain",
        "no-eval",
        "default-param-last"
      ]
    }
  },
  "lock": false
}
