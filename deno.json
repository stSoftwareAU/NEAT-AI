    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/path": "jsr:@std/path@1.1.5",
    "@std/uuid": "jsr:@std/uuid@1.1.1",
    "@std/yaml": "jsr:@std/yaml@1.1.1",
    "@std/testing/mock": "jsr:@std/testing@1.0.19/mock",
    "@stsoftware/tags": "jsr:@stsoftware/tags@1.0.13",
    "@architecture/": "./src/architecture/",
    "@blackbox/": "./src/blackbox/",
    "@breed/": "./src/breed/",
    "@cache/": "./src/cache/",
    "@compact/": "./src/compact/",
    "@config/": "./src/config/",
    "@costs/": "./src/costs/",
    "@creature/": "./src/creature/",
    "@deprecated/": "./src/deprecated/",
    "@discovery/": "./src/discovery/",
    "@errors/": "./src/errors/",
    "@intelligentDesign/": "./src/intelligentDesign/",
    "@methods/": "./src/methods/",
    "@multithreading/": "./src/multithreading/",
    "@mutate/": "./src/mutate/",
    "@neat/": "./src/NEAT/",
    "@neuron/": "./src/neuron/",
    "@onnx/": "./src/onnx/",
    "@optimize/": "./src/optimize/",
    "@predictiveCoding/": "./src/predictiveCoding/",
    "@presets/": "./src/presets/",
    "@propagate/": "./src/propagate/",
    "@reconstruct/": "./src/reconstruct/",
    "@transfer/": "./src/transfer/",
    "@upgrade/": "./src/upgrade/",
    "@utils/": "./src/utils/",
    "@wasm/": "./src/wasm/",
    "@workers/": "./src/workers/",
    "@connectionOptions": "./src/ConnectionOptions.ts",
    "@costs": "./src/Costs.ts",
    "@creature": "./src/Creature.ts",
    "@globalAccessors": "./src/globalAccessors.ts"
  },
  "test": {
    "include": [
      "test/**/*.ts"
    ]
  },
  "fmt": {
    "exclude": [
      "wasm_activation/pkg"
    ]
  },
  "lint": {
    "exclude": [
      "wasm_activation/pkg"
    ],
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "ban-untagged-todo",
        "camelcase",
        "eqeqeq",
        "no-await-in-loop",
        "no-const-assign",
        "no-useless-rename",
        "no-throw-literal",
        "no-sync-fn-in-async-fn",
        "no-sparse-arrays",
        "no-self-compare",
        "no-non-null-asserted-optional-chain",
        "no-eval",
        "default-param-last",
        "no-import-prefix"
      ]
    }
  },
  "exclude": [
    ".analysis",
    ".coverage",
    "junit-raw.xml",
    "junit.xml",
    "test-errors.log"
  ]
}
