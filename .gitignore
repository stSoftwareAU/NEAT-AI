# Ignore invisible
.*
*~
logback.log
!.gitignore
!.markdownlint-cli2.jsonc
coverage/
# Per-shard coverage dirs are deliberately non-hidden so upload-artifact keeps
# them (Issue #3550); ignore them so a local run never commits one.
coverage-*/
target/
junit.xml
!.github
!.gitleaks.toml
on/

# --- Vibe Coder safety patterns (Issue #1751) ---
!.vibecoder.json
.config.json
.config*.json
*.secret.json
.secrets/
.env
.env.*
# --- end Vibe Coder safety patterns ---
